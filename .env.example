# ==========================================
# OPENFRONT MARKETPLACE - ENVIRONMENT CONFIG
# ==========================================

# === AI CONFIGURATION (GLOBAL MODE) ===
# Set these environment variables to enable Global Mode where all users share your OpenRouter API key
# If not set, users must provide their own OpenRouter key (Local Mode)
# See README.md for details on Global Mode vs Local Mode vs MCP Client Mode

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MAX_TOKENS=4000

# Local/BYOK mode is enabled by default. Set this to true to force Global Mode
# and hide the Global/Local configuration switch from users.
MARKETPLACE_DISABLE_LOCAL_AI=false

# Optional restriction for custom OpenAI-compatible endpoints. When omitted,
# users may connect to any public HTTPS origin. In development, loopback and
# .local HTTP(S) endpoints are also permitted. Separate origins with commas.
# MARKETPLACE_CUSTOM_AI_ORIGINS=https://proxy.example.com,https://ai.example.org

# Get your OpenRouter API key at: https://openrouter.ai/keys
# Browse available models at: https://openrouter.ai/models